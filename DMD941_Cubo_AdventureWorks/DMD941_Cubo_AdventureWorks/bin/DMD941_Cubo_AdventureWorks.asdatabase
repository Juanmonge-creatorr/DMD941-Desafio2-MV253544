          <Commands>
            <Command>
              <Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[Margen %] AS IIF([Measures].[Ventas] = 0, NULL, [Measures].[Utilidad] / [Measures].[Ventas]), FORMAT_STRING = "Percent", VISIBLE = 1;</Text>
