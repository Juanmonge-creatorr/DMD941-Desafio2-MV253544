<!-- DMD941 - Desafio Practico 2 - Juan Carlos Monge Ventura (MV253544)
     Script XMLA que crea la base OLAP multidimensional, su vista de origen de datos (DSV),
     las dimensiones Fecha, Producto, Territorio y Canal, y el cubo "Ventas AW". -->
<Batch xmlns="http://schemas.microsoft.com/analysisservices/2003/engine">
<Create>
<ObjectDefinition>
<Database xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ID>DMD941_AdventureWorks_OLAP</ID>
  <Name>DMD941_AdventureWorks_OLAP</Name>
  <Language>1033</Language>
  <Collation>Latin1_General_CI_AS</Collation>
  <DataSources>
    <DataSource xsi:type="RelationalDataSource">
      <ID>AdventureWorksDW</ID>
      <Name>AdventureWorksDW</Name>
      <ConnectionString>Data Source=localhost;Initial Catalog=AdventureWorksDW2022;Integrated Security=True;TrustServerCertificate=True</ConnectionString>
      <ManagedProvider>System.Data.SqlClient</ManagedProvider>
      <ImpersonationInfo>
        <ImpersonationMode>ImpersonateServiceAccount</ImpersonationMode>
      </ImpersonationInfo>
      <Timeout>PT0S</Timeout>
    </DataSource>
  </DataSources>
  <DataSourceViews>
    <DataSourceView>
      <ID>DSV AW</ID>
      <Name>DSV AW</Name>
      <DataSourceID>AdventureWorksDW</DataSourceID>
      <Schema>
        <xs:schema id="DSV_x0020_AW" xmlns="" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" xmlns:msprop="urn:schemas-microsoft-com:xml-msprop">
          <xs:element name="DSV_x0020_AW" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
            <xs:complexType>
              <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="vDate" msprop:DbTableName="vDate" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="vDate" msprop:QueryDefinition="SELECT DateKey, CONVERT(nvarchar(10), FullDateAlternateKey, 23) AS FechaNombre, CAST(CalendarYear AS int) AS Anio, CAST(CalendarYear AS int) * 10 + CAST(CalendarQuarter AS int) AS TrimestreKey, N'T' + CAST(CalendarQuarter AS nvarchar(1)) + N' ' + CAST(CalendarYear AS nvarchar(4)) AS TrimestreNombre, CAST(CalendarQuarter AS int) AS NumTrimestre, N'T' + CAST(CalendarQuarter AS nvarchar(1)) AS NumTrimestreNombre, CAST(CalendarYear AS int) * 100 + CAST(MonthNumberOfYear AS int) AS MesKey, SpanishMonthName + N' ' + CAST(CalendarYear AS nvarchar(4)) AS MesNombre FROM dbo.DimDate">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="DateKey" msprop:DbColumnName="DateKey" msprop:FriendlyName="DateKey" type="xs:int" />
                      <xs:element name="FechaNombre" msprop:DbColumnName="FechaNombre" msprop:FriendlyName="FechaNombre" minOccurs="0"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="10" /></xs:restriction></xs:simpleType></xs:element>
                      <xs:element name="Anio" msprop:DbColumnName="Anio" msprop:FriendlyName="Anio" type="xs:int" minOccurs="0" />
                      <xs:element name="TrimestreKey" msprop:DbColumnName="TrimestreKey" msprop:FriendlyName="TrimestreKey" type="xs:int" minOccurs="0" />
                      <xs:element name="TrimestreNombre" msprop:DbColumnName="TrimestreNombre" msprop:FriendlyName="TrimestreNombre" minOccurs="0"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="10" /></xs:restriction></xs:simpleType></xs:element>
                      <xs:element name="NumTrimestre" msprop:DbColumnName="NumTrimestre" msprop:FriendlyName="NumTrimestre" type="xs:int" minOccurs="0" />
                      <xs:element name="NumTrimestreNombre" msprop:DbColumnName="NumTrimestreNombre" msprop:FriendlyName="NumTrimestreNombre" minOccurs="0"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="5" /></xs:restriction></xs:simpleType></xs:element>
                      <xs:element name="MesKey" msprop:DbColumnName="MesKey" msprop:FriendlyName="MesKey" type="xs:int" minOccurs="0" />
                      <xs:element name="MesNombre" msprop:DbColumnName="MesNombre" msprop:FriendlyName="MesNombre" minOccurs="0"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="40" /></xs:restriction></xs:simpleType></xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="vProduct" msprop:DbTableName="vProduct" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="vProduct" msprop:QueryDefinition="SELECT p.ProductKey, p.EnglishProductName AS Producto, CAST(ISNULL(sc.ProductSubcategoryKey, 0) AS int) AS SubcategoriaKey, ISNULL(sc.SpanishProductSubcategoryName, N'Sin subcategoria') AS Subcategoria, CAST(ISNULL(c.ProductCategoryKey, 0) AS int) AS CategoriaKey, ISNULL(c.SpanishProductCategoryName, N'Sin categoria') AS Categoria FROM dbo.DimProduct AS p LEFT JOIN dbo.DimProductSubcategory AS sc ON p.ProductSubcategoryKey = sc.ProductSubcategoryKey LEFT JOIN dbo.DimProductCategory AS c ON sc.ProductCategoryKey = c.ProductCategoryKey">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="ProductKey" msprop:DbColumnName="ProductKey" msprop:FriendlyName="ProductKey" type="xs:int" />
                      <xs:element name="Producto" msprop:DbColumnName="Producto" msprop:FriendlyName="Producto" minOccurs="0"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="50" /></xs:restriction></xs:simpleType></xs:element>
                      <xs:element name="SubcategoriaKey" msprop:DbColumnName="SubcategoriaKey" msprop:FriendlyName="SubcategoriaKey" type="xs:int" minOccurs="0" />
                      <xs:element name="Subcategoria" msprop:DbColumnName="Subcategoria" msprop:FriendlyName="Subcategoria" minOccurs="0"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="50" /></xs:restriction></xs:simpleType></xs:element>
                      <xs:element name="CategoriaKey" msprop:DbColumnName="CategoriaKey" msprop:FriendlyName="CategoriaKey" type="xs:int" minOccurs="0" />
                      <xs:element name="Categoria" msprop:DbColumnName="Categoria" msprop:FriendlyName="Categoria" minOccurs="0"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="50" /></xs:restriction></xs:simpleType></xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="vTerritory" msprop:DbTableName="vTerritory" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="vTerritory" msprop:QueryDefinition="SELECT SalesTerritoryKey, SalesTerritoryRegion AS Region, SalesTerritoryCountry AS Pais, SalesTerritoryGroup AS Grupo FROM dbo.DimSalesTerritory">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="SalesTerritoryKey" msprop:DbColumnName="SalesTerritoryKey" msprop:FriendlyName="SalesTerritoryKey" type="xs:int" />
                      <xs:element name="Region" msprop:DbColumnName="Region" msprop:FriendlyName="Region" minOccurs="0"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="50" /></xs:restriction></xs:simpleType></xs:element>
                      <xs:element name="Pais" msprop:DbColumnName="Pais" msprop:FriendlyName="Pais" minOccurs="0"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="50" /></xs:restriction></xs:simpleType></xs:element>
                      <xs:element name="Grupo" msprop:DbColumnName="Grupo" msprop:FriendlyName="Grupo" minOccurs="0"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="50" /></xs:restriction></xs:simpleType></xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="vChannel" msprop:DbTableName="vChannel" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="vChannel" msprop:QueryDefinition="SELECT 1 AS CanalKey, N'Internet' AS Canal UNION ALL SELECT 2, N'Reseller'">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="CanalKey" msprop:DbColumnName="CanalKey" msprop:FriendlyName="CanalKey" type="xs:int" />
                      <xs:element name="Canal" msprop:DbColumnName="Canal" msprop:FriendlyName="Canal" minOccurs="0"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="20" /></xs:restriction></xs:simpleType></xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="vFactSales" msprop:DbTableName="vFactSales" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="vFactSales" msprop:QueryDefinition="SELECT 1 AS CanalKey, ProductKey, OrderDateKey, SalesTerritoryKey, CAST(OrderQuantity AS int) AS Cantidad, CAST(SalesAmount AS float) AS Ventas, CAST(TotalProductCost AS float) AS Costo, CAST(SalesAmount - TotalProductCost AS float) AS Utilidad FROM dbo.FactInternetSales UNION ALL SELECT 2, ProductKey, OrderDateKey, SalesTerritoryKey, CAST(OrderQuantity AS int), CAST(SalesAmount AS float), CAST(TotalProductCost AS float), CAST(SalesAmount - TotalProductCost AS float) FROM dbo.FactResellerSales">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="CanalKey" msprop:DbColumnName="CanalKey" msprop:FriendlyName="CanalKey" type="xs:int" />
                      <xs:element name="ProductKey" msprop:DbColumnName="ProductKey" msprop:FriendlyName="ProductKey" type="xs:int" />
                      <xs:element name="OrderDateKey" msprop:DbColumnName="OrderDateKey" msprop:FriendlyName="OrderDateKey" type="xs:int" />
                      <xs:element name="SalesTerritoryKey" msprop:DbColumnName="SalesTerritoryKey" msprop:FriendlyName="SalesTerritoryKey" type="xs:int" />
                      <xs:element name="Cantidad" msprop:DbColumnName="Cantidad" msprop:FriendlyName="Cantidad" type="xs:int" minOccurs="0" />
                      <xs:element name="Ventas" msprop:DbColumnName="Ventas" msprop:FriendlyName="Ventas" type="xs:double" minOccurs="0" />
                      <xs:element name="Costo" msprop:DbColumnName="Costo" msprop:FriendlyName="Costo" type="xs:double" minOccurs="0" />
                      <xs:element name="Utilidad" msprop:DbColumnName="Utilidad" msprop:FriendlyName="Utilidad" type="xs:double" minOccurs="0" />
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
              </xs:choice>
            </xs:complexType>
          </xs:element>
        </xs:schema>
        <DSV_x0020_AW xmlns="" />
      </Schema>
    </DataSourceView>
  </DataSourceViews>
  <Dimensions>
    <Dimension>
      <ID>Fecha</ID>
      <Name>Fecha</Name>
      <Source xsi:type="DataSourceViewBinding"><DataSourceViewID>DSV AW</DataSourceViewID></Source>
      <Attributes>
        <Attribute>
          <ID>Fecha</ID><Name>Fecha</Name><Usage>Key</Usage>
          <KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vDate</TableID><ColumnID>DateKey</ColumnID></Source></KeyColumn></KeyColumns>
          <NameColumn><DataType>WChar</DataType><DataSize>10</DataSize><Source xsi:type="ColumnBinding"><TableID>vDate</TableID><ColumnID>FechaNombre</ColumnID></Source></NameColumn>
          <AttributeRelationships>
            <AttributeRelationship><AttributeID>Mes</AttributeID><Name>Mes</Name></AttributeRelationship>
            <AttributeRelationship><AttributeID>Numero Trimestre</AttributeID><Name>Numero Trimestre</Name></AttributeRelationship>
          </AttributeRelationships>
          <OrderBy>Key</OrderBy>
        </Attribute>
        <Attribute>
          <ID>Mes</ID><Name>Mes</Name>
          <KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vDate</TableID><ColumnID>MesKey</ColumnID></Source></KeyColumn></KeyColumns>
          <NameColumn><DataType>WChar</DataType><DataSize>40</DataSize><Source xsi:type="ColumnBinding"><TableID>vDate</TableID><ColumnID>MesNombre</ColumnID></Source></NameColumn>
          <AttributeRelationships>
            <AttributeRelationship><AttributeID>Trimestre</AttributeID><Name>Trimestre</Name></AttributeRelationship>
          </AttributeRelationships>
          <OrderBy>Key</OrderBy>
        </Attribute>
        <Attribute>
          <ID>Trimestre</ID><Name>Trimestre</Name>
          <KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vDate</TableID><ColumnID>TrimestreKey</ColumnID></Source></KeyColumn></KeyColumns>
          <NameColumn><DataType>WChar</DataType><DataSize>10</DataSize><Source xsi:type="ColumnBinding"><TableID>vDate</TableID><ColumnID>TrimestreNombre</ColumnID></Source></NameColumn>
          <AttributeRelationships>
            <AttributeRelationship><AttributeID>Anio</AttributeID><Name>Anio</Name></AttributeRelationship>
          </AttributeRelationships>
          <OrderBy>Key</OrderBy>
        </Attribute>
        <Attribute>
          <ID>Anio</ID><Name>Anio</Name>
          <KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vDate</TableID><ColumnID>Anio</ColumnID></Source></KeyColumn></KeyColumns>
          <OrderBy>Key</OrderBy>
        </Attribute>
        <Attribute>
          <ID>Numero Trimestre</ID><Name>Numero Trimestre</Name>
          <KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vDate</TableID><ColumnID>NumTrimestre</ColumnID></Source></KeyColumn></KeyColumns>
          <NameColumn><DataType>WChar</DataType><DataSize>5</DataSize><Source xsi:type="ColumnBinding"><TableID>vDate</TableID><ColumnID>NumTrimestreNombre</ColumnID></Source></NameColumn>
          <OrderBy>Key</OrderBy>
        </Attribute>
      </Attributes>
      <Hierarchies>
        <Hierarchy>
          <ID>Calendario</ID><Name>Calendario</Name>
          <Levels>
            <Level><ID>Anio</ID><Name>Anio</Name><SourceAttributeID>Anio</SourceAttributeID></Level>
            <Level><ID>Trimestre</ID><Name>Trimestre</Name><SourceAttributeID>Trimestre</SourceAttributeID></Level>
            <Level><ID>Mes</ID><Name>Mes</Name><SourceAttributeID>Mes</SourceAttributeID></Level>
            <Level><ID>Fecha</ID><Name>Fecha</Name><SourceAttributeID>Fecha</SourceAttributeID></Level>
          </Levels>
        </Hierarchy>
      </Hierarchies>
    </Dimension>
    <Dimension>
      <ID>Producto</ID>
      <Name>Producto</Name>
      <Source xsi:type="DataSourceViewBinding"><DataSourceViewID>DSV AW</DataSourceViewID></Source>
      <Attributes>
        <Attribute>
          <ID>Producto</ID><Name>Producto</Name><Usage>Key</Usage>
          <KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vProduct</TableID><ColumnID>ProductKey</ColumnID></Source></KeyColumn></KeyColumns>
          <NameColumn><DataType>WChar</DataType><DataSize>50</DataSize><Source xsi:type="ColumnBinding"><TableID>vProduct</TableID><ColumnID>Producto</ColumnID></Source></NameColumn>
          <AttributeRelationships>
            <AttributeRelationship><AttributeID>Subcategoria</AttributeID><Name>Subcategoria</Name></AttributeRelationship>
          </AttributeRelationships>
          <OrderBy>Name</OrderBy>
        </Attribute>
        <Attribute>
          <ID>Subcategoria</ID><Name>Subcategoria</Name>
          <KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vProduct</TableID><ColumnID>SubcategoriaKey</ColumnID></Source></KeyColumn></KeyColumns>
          <NameColumn><DataType>WChar</DataType><DataSize>50</DataSize><Source xsi:type="ColumnBinding"><TableID>vProduct</TableID><ColumnID>Subcategoria</ColumnID></Source></NameColumn>
          <AttributeRelationships>
            <AttributeRelationship><AttributeID>Categoria</AttributeID><Name>Categoria</Name></AttributeRelationship>
          </AttributeRelationships>
          <OrderBy>Name</OrderBy>
        </Attribute>
        <Attribute>
          <ID>Categoria</ID><Name>Categoria</Name>
          <KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vProduct</TableID><ColumnID>CategoriaKey</ColumnID></Source></KeyColumn></KeyColumns>
          <NameColumn><DataType>WChar</DataType><DataSize>50</DataSize><Source xsi:type="ColumnBinding"><TableID>vProduct</TableID><ColumnID>Categoria</ColumnID></Source></NameColumn>
          <OrderBy>Name</OrderBy>
        </Attribute>
      </Attributes>
      <Hierarchies>
        <Hierarchy>
          <ID>Categorias</ID><Name>Categorias</Name>
          <Levels>
            <Level><ID>Categoria</ID><Name>Categoria</Name><SourceAttributeID>Categoria</SourceAttributeID></Level>
            <Level><ID>Subcategoria</ID><Name>Subcategoria</Name><SourceAttributeID>Subcategoria</SourceAttributeID></Level>
            <Level><ID>Producto</ID><Name>Producto</Name><SourceAttributeID>Producto</SourceAttributeID></Level>
          </Levels>
        </Hierarchy>
      </Hierarchies>
    </Dimension>
    <Dimension>
      <ID>Territorio</ID>
      <Name>Territorio</Name>
      <Source xsi:type="DataSourceViewBinding"><DataSourceViewID>DSV AW</DataSourceViewID></Source>
      <Attributes>
        <Attribute>
          <ID>Region</ID><Name>Region</Name><Usage>Key</Usage>
          <KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vTerritory</TableID><ColumnID>SalesTerritoryKey</ColumnID></Source></KeyColumn></KeyColumns>
          <NameColumn><DataType>WChar</DataType><DataSize>50</DataSize><Source xsi:type="ColumnBinding"><TableID>vTerritory</TableID><ColumnID>Region</ColumnID></Source></NameColumn>
          <AttributeRelationships>
            <AttributeRelationship><AttributeID>Pais</AttributeID><Name>Pais</Name></AttributeRelationship>
          </AttributeRelationships>
          <OrderBy>Name</OrderBy>
        </Attribute>
        <Attribute>
          <ID>Pais</ID><Name>Pais</Name>
          <KeyColumns><KeyColumn><DataType>WChar</DataType><DataSize>50</DataSize><Source xsi:type="ColumnBinding"><TableID>vTerritory</TableID><ColumnID>Pais</ColumnID></Source></KeyColumn></KeyColumns>
          <AttributeRelationships>
            <AttributeRelationship><AttributeID>Grupo</AttributeID><Name>Grupo</Name></AttributeRelationship>
          </AttributeRelationships>
          <OrderBy>Name</OrderBy>
        </Attribute>
        <Attribute>
          <ID>Grupo</ID><Name>Grupo</Name>
          <KeyColumns><KeyColumn><DataType>WChar</DataType><DataSize>50</DataSize><Source xsi:type="ColumnBinding"><TableID>vTerritory</TableID><ColumnID>Grupo</ColumnID></Source></KeyColumn></KeyColumns>
          <OrderBy>Name</OrderBy>
        </Attribute>
      </Attributes>
      <Hierarchies>
        <Hierarchy>
          <ID>Geografia</ID><Name>Geografia</Name>
          <Levels>
            <Level><ID>Grupo</ID><Name>Grupo</Name><SourceAttributeID>Grupo</SourceAttributeID></Level>
            <Level><ID>Pais</ID><Name>Pais</Name><SourceAttributeID>Pais</SourceAttributeID></Level>
            <Level><ID>Region</ID><Name>Region</Name><SourceAttributeID>Region</SourceAttributeID></Level>
          </Levels>
        </Hierarchy>
      </Hierarchies>
    </Dimension>
    <Dimension>
      <ID>Canal</ID>
      <Name>Canal</Name>
      <Source xsi:type="DataSourceViewBinding"><DataSourceViewID>DSV AW</DataSourceViewID></Source>
      <Attributes>
        <Attribute>
          <ID>Canal</ID><Name>Canal</Name><Usage>Key</Usage>
          <KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vChannel</TableID><ColumnID>CanalKey</ColumnID></Source></KeyColumn></KeyColumns>
          <NameColumn><DataType>WChar</DataType><DataSize>20</DataSize><Source xsi:type="ColumnBinding"><TableID>vChannel</TableID><ColumnID>Canal</ColumnID></Source></NameColumn>
          <OrderBy>Key</OrderBy>
        </Attribute>
      </Attributes>
    </Dimension>
  </Dimensions>
  <Cubes>
    <Cube>
      <ID>Ventas AW</ID>
      <Name>Ventas AW</Name>
      <Language>1033</Language>
      <Dimensions>
        <Dimension><ID>Fecha</ID><Name>Fecha</Name><DimensionID>Fecha</DimensionID></Dimension>
        <Dimension><ID>Producto</ID><Name>Producto</Name><DimensionID>Producto</DimensionID></Dimension>
        <Dimension><ID>Territorio</ID><Name>Territorio</Name><DimensionID>Territorio</DimensionID></Dimension>
        <Dimension><ID>Canal</ID><Name>Canal</Name><DimensionID>Canal</DimensionID></Dimension>
      </Dimensions>
      <MeasureGroups>
        <MeasureGroup>
          <ID>Ventas</ID>
          <Name>Ventas</Name>
          <Measures>
            <Measure><ID>Ventas</ID><Name>Ventas</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType>
              <Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>vFactSales</TableID><ColumnID>Ventas</ColumnID></Source></Source>
              <FormatString>Currency</FormatString></Measure>
            <Measure><ID>Costo</ID><Name>Costo</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType>
              <Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>vFactSales</TableID><ColumnID>Costo</ColumnID></Source></Source>
              <FormatString>Currency</FormatString></Measure>
            <Measure><ID>Utilidad</ID><Name>Utilidad</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType>
              <Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>vFactSales</TableID><ColumnID>Utilidad</ColumnID></Source></Source>
              <FormatString>Currency</FormatString></Measure>
            <Measure><ID>Cantidad</ID><Name>Cantidad</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType>
              <Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vFactSales</TableID><ColumnID>Cantidad</ColumnID></Source></Source>
              <FormatString>#,##0</FormatString></Measure>
          </Measures>
          <StorageMode>Molap</StorageMode>
          <Dimensions>
            <Dimension xsi:type="RegularMeasureGroupDimension">
              <CubeDimensionID>Fecha</CubeDimensionID>
              <Attributes><Attribute><AttributeID>Fecha</AttributeID>
                <KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vFactSales</TableID><ColumnID>OrderDateKey</ColumnID></Source></KeyColumn></KeyColumns>
                <Type>Granularity</Type></Attribute></Attributes>
            </Dimension>
            <Dimension xsi:type="RegularMeasureGroupDimension">
              <CubeDimensionID>Producto</CubeDimensionID>
              <Attributes><Attribute><AttributeID>Producto</AttributeID>
                <KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vFactSales</TableID><ColumnID>ProductKey</ColumnID></Source></KeyColumn></KeyColumns>
                <Type>Granularity</Type></Attribute></Attributes>
            </Dimension>
            <Dimension xsi:type="RegularMeasureGroupDimension">
              <CubeDimensionID>Territorio</CubeDimensionID>
              <Attributes><Attribute><AttributeID>Region</AttributeID>
                <KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vFactSales</TableID><ColumnID>SalesTerritoryKey</ColumnID></Source></KeyColumn></KeyColumns>
                <Type>Granularity</Type></Attribute></Attributes>
            </Dimension>
            <Dimension xsi:type="RegularMeasureGroupDimension">
              <CubeDimensionID>Canal</CubeDimensionID>
              <Attributes><Attribute><AttributeID>Canal</AttributeID>
                <KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>vFactSales</TableID><ColumnID>CanalKey</ColumnID></Source></KeyColumn></KeyColumns>
                <Type>Granularity</Type></Attribute></Attributes>
            </Dimension>
          </Dimensions>
          <Partitions>
            <Partition>
              <ID>Ventas</ID><Name>Ventas</Name>
              <Source xsi:type="DsvTableBinding"><DataSourceViewID>DSV AW</DataSourceViewID><TableID>vFactSales</TableID></Source>
              <StorageMode>Molap</StorageMode>
            </Partition>
          </Partitions>
        </MeasureGroup>
      </MeasureGroups>
      <Source><DataSourceViewID>DSV AW</DataSourceViewID></Source>
      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID><Name>MdxScript</Name>
          <Commands><Command><Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[Margen %] AS IIF([Measures].[Ventas] = 0, NULL, [Measures].[Utilidad] / [Measures].[Ventas]), FORMAT_STRING = "Percent", VISIBLE = 1;</Text></Command></Commands>
        </MdxScript>
      </MdxScripts>
    </Cube>
  </Cubes>
</Database>
</ObjectDefinition>
</Create>
</Batch>
